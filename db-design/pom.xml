<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.systemdesign</groupId>
        <artifactId>system-design-practice</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>db-design</artifactId>

    <name>Database Design</name>
    <description>Database design problems: relational, NoSQL, hybrid, advanced</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <!-- Relational -->
                    <execution>
                        <id>add-relational-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>problems/relational/content-cms</source>
                                <source>problems/relational/ecommerce-schema</source>
                                <source>problems/relational/hospital-management</source>
                                <source>problems/relational/ride-sharing</source>
                                <source>problems/relational/saas-multitenancy</source>
                                <source>problems/relational/social-network</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!-- NoSQL -->
                    <execution>
                        <id>add-nosql-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>problems/nosql/clickstream-analytics</source>
                                <source>problems/nosql/iot-timeseries</source>
                                <source>problems/nosql/product-catalog</source>
                                <source>problems/nosql/realtime-chat</source>
                                <source>problems/nosql/session-store</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!-- Hybrid -->
                    <execution>
                        <id>add-hybrid-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>problems/hybrid/analytics-pipeline</source>
                                <source>problems/hybrid/log-aggregation</source>
                                <source>problems/hybrid/recommendation-system</source>
                                <source>problems/hybrid/search-engine</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!-- Advanced -->
                    <execution>
                        <id>add-advanced-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>problems/advanced/backup-recovery</source>
                                <source>problems/advanced/cdc-pipeline</source>
                                <source>problems/advanced/consistency-models</source>
                                <source>problems/advanced/data-migration</source>
                                <source>problems/advanced/sharding-strategy</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
